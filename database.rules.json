{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || data.child('visible').val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online','lastSeen','visible'])",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "visible": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
