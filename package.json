{
  "name": "gather-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,database --project demo-gather \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-gather",
    "preview": "vite preview --host 127.0.0.1",
    "test:integration": "firebase emulators:exec --only auth,firestore,database --project demo-gather \"vitest run --config vitest.integration.config.ts --mode emulator\"",
    "dev:emulator": "vite --host 127.0.0.1 --mode emulator",
    "format": "prettier --write src tests *.ts *.json *.js *.md netlify"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "date-fns": "4.4.0",
    "emoji-picker-react": "5.1.4",
    "firebase": "13.1.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@netlify/functions": "6.0.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "firebase-tools": "15.34.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
