rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function me(){return request.auth.uid;}
  function profile(uid){return get(/databases/$(database)/documents/users/$(uid));}
  function unblocked(a,b){return !exists(/databases/$(database)/documents/users/$(a)/blocks/$(b)) && !exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));}
  function chat(id){return get(/databases/$(database)/documents/chats/$(id)).data;}
  function member(id){return signed() && me() in chat(id).members;}
  function contact(c){return c.kind == 'group' || unblocked(c.members[0],c.members[1]);}
  function profileValid(d){return d.keys().hasOnly(['uid','username','displayName','bio','avatar','photoURL','discoverable','showPresence','createdAt','updatedAt']) && (!('photoURL' in d) || d.photoURL==null || d.photoURL is string && d.photoURL.size()<=32768 && d.photoURL.matches('^data:image/jpeg;base64,/9j/[A-Za-z0-9+/]+={0,2}$')) && d.uid == me() && d.username is string && d.username.matches('^[a-z][a-z0-9_]{2,23}$') && d.displayName is string && d.displayName.size()>0 && d.displayName.size()<=60 && d.bio is string && d.bio.size()<=240 && d.avatar in ['sage','peach','lavender','sky','sun','rose'] && d.discoverable is bool && d.showPresence is bool && d.updatedAt == request.time && getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid==me();}
  match /users/{uid} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && uid==me() && profileValid(request.resource.data) && request.resource.data.createdAt==request.time;
   allow update: if signed() && uid==me() && profileValid(request.resource.data) && request.resource.data.createdAt==resource.data.createdAt && (request.resource.data.username==resource.data.username || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username)));
   allow delete: if signed() && uid==me() && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username));
   match /chatPreferences/{chatId} {
    allow read: if signed() && uid==me();
    allow create,update: if signed() && uid==me() && member(chatId) && request.resource.data.keys().hasOnly(['readAt','hiddenAt']) && (!('readAt' in request.resource.data) || request.resource.data.readAt==request.time || request.resource.data.readAt==resource.data.readAt) && (!('hiddenAt' in request.resource.data) || request.resource.data.hiddenAt==request.time || request.resource.data.hiddenAt==resource.data.hiddenAt);
    allow delete: if signed() && uid==me();
   }
   match /blocks/{other} {
    allow read,delete: if signed() && uid==me();
    allow create,update: if signed() && uid==me() && other!=me() && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt==request.time;
   }
  }
  match /usernames/{name} {
   allow get: if signed() && (!exists(/databases/$(database)/documents/usernames/$(name)) || resource.data.uid==me() || profile(resource.data.uid).data.discoverable);
   allow list: if false;
   allow create: if signed() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid==me() && getAfter(/databases/$(database)/documents/users/$(me())).data.username==name;
   allow update: if false;
   allow delete: if signed() && resource.data.uid==me() && (!existsAfter(/databases/$(database)/documents/users/$(me())) || getAfter(/databases/$(database)/documents/users/$(me())).data.username!=name);
  }
  match /chats/{id} {
   function valid(d){return d.keys().hasOnly(['kind','avatar','members','admin','name','description','createdAt','updatedAt','lastText','lastSender']) && (!('avatar' in d) || d.avatar in ['sage','peach','lavender','sky','sun','rose']) && d.members is list && d.members.size()<=20 && d.members.toSet().size()==d.members.size() && d.admin is string && d.name is string && d.name.size()<=60 && d.description is string && d.description.size()<=240 && d.lastText is string && d.lastText.size()<=120 && d.lastSender is string && d.updatedAt==request.time;}
   allow get: if signed() && (!exists(/databases/$(database)/documents/chats/$(id)) || me() in resource.data.members);
   allow list: if signed() && me() in resource.data.members;
   allow create: if signed() && valid(request.resource.data) && request.resource.data.admin==me() && request.resource.data.createdAt==request.time && request.resource.data.lastText=='' && request.resource.data.lastSender=='' && ((request.resource.data.kind=='group' && request.resource.data.members==[me()] && request.resource.data.name.size()>0) || (request.resource.data.kind=='direct' && request.resource.data.members.size()==2 && request.resource.data.members[0] < request.resource.data.members[1] && me() in request.resource.data.members && id==request.resource.data.members[0]+'_'+request.resource.data.members[1] && unblocked(request.resource.data.members[0],request.resource.data.members[1])));
   allow update: if member(id) && valid(request.resource.data) && request.resource.data.kind==resource.data.kind && request.resource.data.createdAt==resource.data.createdAt && (
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText','lastSender','updatedAt']) && request.resource.data.lastSender==me() && contact(resource.data)) ||
    (resource.data.kind=='group' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar','description','admin','members','updatedAt']) && (
      (resource.data.admin==me() && request.resource.data.members==resource.data.members && request.resource.data.admin in resource.data.members) ||
      (resource.data.admin==me() && request.resource.data.admin==me() && request.resource.data.members.hasAll(resource.data.members) && request.resource.data.members.size()==resource.data.members.size()+1 && unblocked(me(),request.resource.data.members.removeAll(resource.data.members)[0])) ||
      (request.resource.data.admin==resource.data.admin && request.resource.data.members.size()==resource.data.members.size()-1 && resource.data.members.hasAll(request.resource.data.members) && (resource.data.admin==me() || request.resource.data.members==resource.data.members.removeAll([me()]) && request.resource.data.name==resource.data.name && request.resource.data.description==resource.data.description && request.resource.data.get('avatar','sage')==resource.data.get('avatar','sage')) && (!(resource.data.admin in resource.data.members.removeAll(request.resource.data.members)) || request.resource.data.members.size()==0))
    )));
   allow delete: if false;
   match /messages/{messageId} {
    function valid(d){return d.keys().hasOnly(['sender','text','createdAt','editedAt','deleted','reply']) && d.text is string && d.text.size()<=4000 && d.deleted is bool && (d.reply==null || (d.reply is map && d.reply.keys().hasOnly(['id','text']) && d.reply.id is string && d.reply.id.size()<=128 && d.reply.text is string && d.reply.text.size()<=120));}
    allow read: if member(id);
    allow create: if member(id) && contact(chat(id)) && valid(request.resource.data) && request.resource.data.sender==me() && request.resource.data.createdAt==request.time && request.resource.data.editedAt==null && !request.resource.data.deleted && request.resource.data.text.size()>0;
    allow update: if member(id) && contact(chat(id)) && resource.data.sender==me() && !resource.data.deleted && valid(request.resource.data) && request.resource.data.sender==resource.data.sender && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.editedAt==request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt','deleted','reply']) && (request.resource.data.reply==resource.data.reply || request.resource.data.deleted && request.resource.data.reply==null) && (request.resource.data.deleted && request.resource.data.text=='' || !request.resource.data.deleted && request.resource.data.text.size()>0);
    allow delete: if false;
    match /reactions/{uid} {
     allow read: if member(id);
     allow create,update: if member(id) && uid==me() && contact(chat(id)) && request.resource.data.keys().hasOnly(['emoji']) && request.resource.data.emoji in ['❤️','👍','😂','🎉','😮','🙏'];
     allow delete: if member(id) && uid==me();
    }
   }
   match /receipts/{uid} {
    allow read: if member(id);
    allow create,update: if member(id) && uid==me() && request.resource.data.keys().hasOnly(['readAt','deliveredAt','hiddenAt','typingUntil']) && (!('readAt' in request.resource.data) || request.resource.data.readAt==request.time || request.resource.data.readAt==resource.data.readAt) && (!('deliveredAt' in request.resource.data) || request.resource.data.deliveredAt==request.time || request.resource.data.deliveredAt==resource.data.deliveredAt) && (!('hiddenAt' in request.resource.data) || request.resource.data.hiddenAt==request.time || request.resource.data.hiddenAt==resource.data.hiddenAt) && (!('typingUntil' in request.resource.data) || request.resource.data.typingUntil is int && request.resource.data.typingUntil<=request.time.toMillis()+10000);
   }
  }
  match /calls/{callId} {
   function party(){return signed() && me() in resource.data.participants;}
   function sdp(d,type){return d is map && d.keys().hasOnly(['type','sdp']) && d.type==type && d.sdp is string && d.sdp.size()<=30000;}
   allow read: if party();
   allow create: if signed() && request.resource.data.keys().hasOnly(['chatId','caller','callee','participants','kind','state','offer','answer','createdAt','updatedAt','expiresAt']) && member(request.resource.data.chatId) && chat(request.resource.data.chatId).kind=='direct' && request.resource.data.caller==me() && request.resource.data.callee!=me() && request.resource.data.callee in chat(request.resource.data.chatId).members && request.resource.data.participants==[me(),request.resource.data.callee] && unblocked(me(),request.resource.data.callee) && request.resource.data.kind in ['voice','video'] && request.resource.data.state=='ringing' && sdp(request.resource.data.offer,'offer') && request.resource.data.answer==null && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time && request.resource.data.expiresAt>request.time && request.resource.data.expiresAt<=request.time+duration.value(65,'s');
   allow update: if party() && ((resource.data.state in ['ended','rejected','missed','failed'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer','answer','updatedAt']) && request.resource.data.offer=={'type':'offer','sdp':''} && request.resource.data.answer==null && request.resource.data.updatedAt==request.time) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','answer','updatedAt']) && request.resource.data.updatedAt==request.time && resource.data.state in ['ringing','connecting','connected'] && (
    (request.resource.data.state in ['ended','failed'] && request.resource.data.answer==resource.data.answer) ||
    (resource.data.state=='ringing' && request.resource.data.state=='missed' && me()==resource.data.caller && request.time>=resource.data.expiresAt && request.resource.data.answer==resource.data.answer) ||
    (resource.data.state=='ringing' && me()==resource.data.callee && ((request.resource.data.state=='rejected' && request.resource.data.answer==null) || (request.resource.data.state=='connecting' && request.time<resource.data.expiresAt && sdp(request.resource.data.answer,'answer')))) ||
    (resource.data.state=='connecting' && request.resource.data.state=='connected' && request.resource.data.answer==resource.data.answer))));
   allow delete: if false;
   match /candidates/{candidateId} {
    function parent(){return get(/databases/$(database)/documents/calls/$(callId)).data;}
    allow read: if signed() && me() in parent().participants;
    allow create: if signed() && me() in parent().participants && parent().state in ['ringing','connecting','connected'] && request.resource.data.keys().hasOnly(['owner','candidate']) && request.resource.data.owner==me() && request.resource.data.candidate is map && request.resource.data.candidate.keys().hasOnly(['candidate','sdpMid','sdpMLineIndex','usernameFragment']) && request.resource.data.candidate.candidate is string && request.resource.data.candidate.candidate.size()<=2000;
    allow delete: if signed() && me() in parent().participants;
   }
  }
 }
}
