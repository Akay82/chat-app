# Public Firebase web identifiers; these are not Admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_URL=
# Local emulators only; NEVER set true in Netlify production.
VITE_USE_EMULATORS=false
# JSON array. Empty means host candidates only. Configure a STUN service you may use.
VITE_ICE_SERVERS=[]
# Never place long-lived TURN secrets in VITE_ variables. Public/ephemeral ICE credentials only.
